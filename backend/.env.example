# =================================================================
# AeroSat-AI: Backend Environment Configuration
# =================================================================

# Server Configuration
PROJECT_NAME="AeroSat-AI"
VERSION="2.0.0"
ENVIRONMENT="development"
DEFAULT_DATA_MODE="REAL"
DEMO_MODE=true

# =================================================================
# COPERNICUS CREDENTIALS CONFIGURATION
# =================================================================
# Enter your Copernicus Sentinel Hub / CDSE OAuth2 credentials below:
# 1. COPERNICUS_CLIENT_ID: Your OAuth Client ID
# 2. COPERNICUS_CLIENT_SECRET: Your OAuth Client Secret
#
# Supported Providers for COPERNICUS_AUTH_PROVIDER:
# - 'auto' (Default: Probes Sentinel Hub first, then CDSE endpoints)
# - 'sentinel_hub' (https://services.sentinel-hub.com/oauth/token)
# - 'cdse_sentinel_hub' (https://sh.dataspace.copernicus.eu/oauth/token)
# - 'cdse_keycloak' (https://identity.dataspace.copernicus.eu/auth/realms/CDSE/protocol/openid-connect/token)
# =================================================================
COPERNICUS_CLIENT_ID=""
COPERNICUS_CLIENT_SECRET=""
COPERNICUS_AUTH_PROVIDER="auto"

# OpenAQ API v3 Key (Optional - free community key from https://openaq.org)
OPENAQ_API_KEY=""

# Open-Meteo Base URL (Public educational tier)
OPEN_METEO_BASE_URL="https://api.open-meteo.com/v1"

# CORS Configuration
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000","http://127.0.0.1:3000"]
