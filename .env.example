# =================================================================
# AeroSat-AI: Environment Configuration Template
# Copy this file to .env and configure credentials if live data is desired.
# By default, the application runs fully in DEMO MODE without any API keys.
# =================================================================

# Server Configuration
PROJECT_NAME="AeroSat-AI"
VERSION="1.0.0"
ENVIRONMENT="development"
DEMO_MODE=true

# Copernicus Data Space Ecosystem (CDSE) / Sentinel-5P TROPOMI
# Free registration: https://dataspace.copernicus.eu
COPERNICUS_CLIENT_ID=""
COPERNICUS_CLIENT_SECRET=""

# OpenAQ API v3 (Optional for higher rate limits on CPCB ground stations)
# Registration: https://openaq.org
OPENAQ_API_KEY=""

# Open-Meteo Planetary Boundary Layer & Weather (Public educational tier - no key required)
OPEN_METEO_BASE_URL="https://api.open-meteo.com/v1"

# CORS Allowed Origins
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000","http://127.0.0.1:3000"]
