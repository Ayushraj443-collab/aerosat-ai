# =================================================================
# AeroSat-AI: Environment Configuration Template
# Copy this file to .env and configure credentials if live data is desired.
# The application features two strictly isolated data modes: REAL and DEMO.
# =================================================================

# Server Configuration
PROJECT_NAME="AeroSat-AI"
VERSION="2.0.0"
ENVIRONMENT="development"

# Default Operating Data Mode: 'REAL' or 'DEMO'
# - REAL: Queries live Copernicus Sentinel-5P OData, Open-Meteo ERA5, Copernicus CAMS, and CPCB observations.
# - DEMO: Generates deterministic physics-based simulation data for offline demonstrations and academic tests.
DEFAULT_DATA_MODE="REAL"
DEMO_MODE=true

# Copernicus Data Space Ecosystem (CDSE) / Sentinel-5P TROPOMI
# Free registration: https://dataspace.copernicus.eu
# Used for downloading raw Sentinel-5P Level-2 NetCDF binary granules.
# (Note: OData catalogue granule discovery works publicly without credentials).
COPERNICUS_CLIENT_ID=""
COPERNICUS_CLIENT_SECRET=""

# OpenAQ API v3 (Global & Indian Ground Monitoring Feeds)
# Free community key registration: https://openaq.org
OPENAQ_API_KEY=""

# Open-Meteo Planetary Boundary Layer & Weather (Public educational tier - no key required)
OPEN_METEO_BASE_URL="https://api.open-meteo.com/v1"

# CORS Allowed Origins
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000","http://127.0.0.1:3000"]

