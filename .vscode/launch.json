{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run P19 AeroSat AI",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": [
        "app.main:app",
        "--app-dir",
        "backend",
        "--host",
        "127.0.0.1",
        "--port",
        "8000"
      ],
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}/backend/venv/Scripts/python.exe",
      "console": "integratedTerminal",
      "justMyCode": false,
      "preLaunchTask": "Start Both Servers"
    }
  ]
}

