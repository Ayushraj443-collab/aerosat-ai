# =====================================================================
# AeroSat-AI Production & Submission .gitignore
# =====================================================================

# Python Environment & Caches
backend/venv/
venv/
ENV/
env/
__pycache__/
*.py[cod]
*$py.class
*.pyd
.pytest_cache/
.coverage
htmlcov/

# Node.js & Frontend Build Artifacts
frontend/node_modules/
node_modules/
frontend/dist/
dist/
.vite/
frontend/.vite/
*.tsbuildinfo

# Security & Credentials
.env
.env.local
.env.*.local
backend/.env
frontend/.env.local
*.pem
*.key

# Backups & Archives
*.bak
*.bak2
*.zip
*.backup*
data/*.backup*
data/satellite_aq.db.backup*

# Temporary test uploads
data/raw/ds_*
data/aerosat.db
backend/aerosat.db

# Large Satellite Files (>100MB GitHub Hard Limit)
data/raw/sentinel5p/*.nc
data/raw/sentinel5p/*.nc4
data/raw/sentinel5p/*.he5
data/raw/sentinel5p/*.hdf
data/raw/cpcb-aqi.csv.gz
*.tar.gz
*.gz
!data/raw/sentinel5p/.gitkeep

# Exclude temporary scratch tests/downloads
scratch/

# Preserve essential database & operational models
!data/satellite_aq.db
!data/models/*.joblib
!data/models/*.json

# IDE Settings
.vscode/*
!.vscode/tasks.json
!.vscode/launch.json
.idea/
.DS_Store
Thumbs.db
